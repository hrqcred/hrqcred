generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  nome      String
  createdAt DateTime @default(now())
}

model Cliente {
  id          String       @id @default(cuid())
  nome        String
  cpf         String       @unique
  telefone    String
  email       String?
  endereco    String?
  plataforma  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  emprestimos Emprestimo[]
}

model Emprestimo {
  id           String      @id @default(cuid())
  clienteId    String
  cliente      Cliente     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  valor        Float
  juros        Float
  tipo         String
  valorTotal   Float
  parcelas     Int
  valorParcela Float
  status       String      @default("PENDENTE")
  dataInicio   DateTime?
  dataFim      DateTime?
  observacoes  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  pagamentos   Pagamento[]
}

model Pagamento {
  id            String     @id @default(cuid())
  emprestimoId  String
  emprestimo    Emprestimo @relation(fields: [emprestimoId], references: [id], onDelete: Cascade)
  valor         Float
  numeroParcela Int
  dataVencimento DateTime
  dataPagamento DateTime?
  status        String     @default("PENDENTE")
  createdAt     DateTime   @default(now())
}

model Solicitacao {
  id        String   @id @default(cuid())
  nome      String
  cpf       String
  telefone  String
  email     String?
  valor     Float
  tipo      String
  parcelas  Int      @default(1)
  mensagem  String?
  status    String   @default("NOVA")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
